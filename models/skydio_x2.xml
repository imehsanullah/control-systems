<mujoco model="Skydio X2 - minimal">
  <compiler angle="degree"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.12 0.22 0.32" rgb2="0.20 0.38 0.55"/>
    <material name="ground" texture="grid" texrepeat="12 12" reflectance="0.15"/>
    <material name="dark" rgba="0.05 0.06 0.07 1"/>
    <material name="metal" rgba="0.25 0.27 0.29 1"/>
    <material name="rotor" rgba="0.85 0.88 0.90 0.72"/>
  </asset>

  <worldbody>
    <light pos="0 -2 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="ground"/>
    <body name="skydio_x2" pos="0 0 0.085">
      <joint name="x" type="slide" axis="1 0 0" range="-2.3 2.3"/>
      <joint name="y" type="slide" axis="0 1 0" range="-1.3 1.3"/>
      <joint name="z" type="slide" axis="0 0 1" range="0 1.8"/>

      <geom name="body" type="box" pos="0 0 0.035" size="0.11 0.055 0.045" material="dark" mass="0.741"/>
      <geom name="camera" type="sphere" pos="0.10 -0.005 0.015" size="0.035" material="metal" mass="0.08"/>

      <geom type="capsule" fromto="0.06 0.035 0.04  0.23 0.18 0.04" size="0.015" material="dark" mass="0.09"/>
      <geom type="capsule" fromto="0.06 -0.035 0.04  0.23 -0.18 0.04" size="0.015" material="dark" mass="0.09"/>
      <geom type="capsule" fromto="-0.06 0.035 0.04  -0.23 0.18 0.04" size="0.015" material="dark" mass="0.09"/>
      <geom type="capsule" fromto="-0.06 -0.035 0.04  -0.23 -0.18 0.04" size="0.015" material="dark" mass="0.09"/>

      <geom type="cylinder" pos="0.23 0.18 0.06" size="0.10 0.006" material="rotor" mass="0.015"/>
      <geom type="cylinder" pos="0.23 -0.18 0.06" size="0.10 0.006" material="rotor" mass="0.015"/>
      <geom type="cylinder" pos="-0.23 0.18 0.06" size="0.10 0.006" material="rotor" mass="0.015"/>
      <geom type="cylinder" pos="-0.23 -0.18 0.06" size="0.10 0.006" material="rotor" mass="0.015"/>

      <geom type="capsule" fromto="0.07 0.045 0.01  0.07 0.045 -0.075" size="0.012" material="metal" mass="0.02"/>
      <geom type="capsule" fromto="0.07 -0.045 0.01  0.07 -0.045 -0.075" size="0.012" material="metal" mass="0.02"/>
      <geom type="capsule" fromto="-0.07 0.045 0.01  -0.07 0.045 -0.075" size="0.012" material="metal" mass="0.02"/>
      <geom type="capsule" fromto="-0.07 -0.045 0.01  -0.07 -0.045 -0.075" size="0.012" material="metal" mass="0.02"/>
      <geom type="capsule" fromto="-0.045 0.018 0.075  -0.045 0.018 0.11" size="0.006" material="dark" mass="0.002"/>
      <geom type="capsule" fromto="-0.045 -0.018 0.075  -0.045 -0.018 0.11" size="0.006" material="dark" mass="0.002"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="force_x" joint="x" ctrllimited="true" ctrlrange="-100 100"/>
    <motor name="force_y" joint="y" ctrllimited="true" ctrlrange="-100 100"/>
    <motor name="force_z" joint="z" ctrllimited="true" ctrlrange="-100 100"/>
  </actuator>
</mujoco>
